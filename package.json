{
  "name": "athlyx",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ATHLYx — camera-based lower-limb movement symmetry monitoring for rehabilitating athletes",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "node server/seed.js"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "@mediapipe/tasks-vision": "^0.10.22",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "recharts": "^3.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
