# ---------------------------------------------------------------
# ATHLYx environment. Copy to .env and fill in what you have.
# Never commit .env — it is git-ignored on purpose.
# ---------------------------------------------------------------

# API server
PORT=3001
API_PORT=3001

# Vite dev server (frontend)
WEB_PORT=5173

# Extra hostnames the dev server will answer for (comma separated). Localhost
# is always allowed. A hosted/cloud dev environment sets its own hostname here.
# PREVIEW_HOST=pv-xxxx.style.dev

# Where the SQLite database lives (defaults to ./data/athlyx.db)
DATABASE_PATH=./data/athlyx.db

# Comma-separated origins allowed to call the API. Leave empty in dev.
CLIENT_ORIGIN=http://localhost:5173

# How long a login token stays valid, in days
SESSION_DAYS=14

# -----------------------------------------------------------------
# OPTIONAL — plain-language explanations only.
# The app never uses Gemini to calculate a score, decide a criteria
# status, or choose exercises. Without a key, /api/insights/explain
# returns 503 and everything else keeps working.
# Get a key from Google AI Studio: https://aistudio.google.com/apikey
# -----------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: override the pose model files the browser loads.
# Defaults are the public MediaPipe CDN endpoints.
# VITE_POSE_MODEL_URL=https://storage.googleapis.com/mediapipe-models/pose_landmarker/pose_landmarker_full/float16/1/pose_landmarker_full.task
# VITE_POSE_WASM_URL=https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.22/wasm
